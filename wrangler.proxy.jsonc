{
  "name": "rebirth-dungeon-d1",
  "main": "worker/d1-proxy.ts",
  "compatibility_date": "2026-09-23",
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "527ce37364ca4e3d8e2974fda76e3b4f",
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rebirth-dungeon",
      "database_id": "b8b044ef-47f2-4dec-9a13-11ce5c2ee31e",
    },
  ],
  "secrets": {
    "required": ["D1_PROXY_TOKEN"],
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01,
    },
  },
}
