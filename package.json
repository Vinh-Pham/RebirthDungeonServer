{
  "name": "rebirth-dungeon-server",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build && node tools/build-worker-assets.mjs",
    "deploy": "npm run worker:deploy",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "worker:types": "wrangler types",
    "worker:check": "npm run build",
    "worker:dev": "wrangler dev",
    "worker:dry-run": "wrangler deploy --dry-run",
    "worker:deploy": "wrangler deploy",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"test/**/*.ts\"",
    "start": "wrangler dev",
    "start:dev": "wrangler dev",
    "lint": "oxlint --type-aware src/ test/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "test:auth": "npm run test:worker",
    "email:test": "npm run test:worker",
    "email:dev": "email dev --dir src/email/templates --port 3001",
    "test:worker": "npm run build && node --test test/worker.integration.mjs"
  },
  "dependencies": {
    "@keyv/cloudflare-kv": "6.0.0-rc.1",
    "@nestjs/cache-manager": "^12.0.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/platform-express": "^12.1.0",
    "@nestjs/swagger": "^12.0.2",
    "@scalar/api-reference": "^1.71.0",
    "@scalar/express-api-reference": "^0.10.21",
    "argon2-wasm-edge": "^1.0.23",
    "cache-manager": "^7.2.9",
    "drizzle-orm": "^1.0.0-rc.4",
    "keyv": "6.0.0-rc.1",
    "keyv-cache-manager": "npm:keyv@5.6.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-email": "^6.11.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@react-email/ui": "^6.11.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.2",
    "drizzle-kit": "^1.0.0-rc.4",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.0",
    "typescript": "^6.0.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.2",
    "wrangler": "^4.137.0",
    "argon2": "^0.45.1",
    "dotenv": "^18.0.3"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "overrides": {
    "@nestjs/cache-manager": {
      "keyv": "$keyv"
    }
  }
}
