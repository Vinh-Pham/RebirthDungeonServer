{
  "name": "rebirth-dungeon-server",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local",
    "deploy": "wrangler deploy --minify",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "node tools/migrate-local.mjs",
    "db:check:remote": "node tools/check-remote.mjs",
    "db:migrate:remote": "node tools/migrate-remote.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && node --test test/migrations.test.mjs test/queues.integration.test.mjs",
    "test:watch": "vitest",
    "deploy:dry-run": "wrangler deploy --dry-run --outdir dist",
    "format": "prettier --write src test tools *.ts *.json *.jsonc README.md",
    "format:check": "prettier --check src test tools *.ts *.json *.jsonc README.md",
    "db:baseline:local": "node tools/migrate-local.mjs --baseline",
    "test:smoke": "node tools/smoke-local.mjs",
    "test:migrations": "node --test test/migrations.test.mjs"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.6.3",
    "@scalar/hono-api-reference": "^0.12.5",
    "argon2-wasm-edge": "1.0.23",
    "drizzle-orm": "1.0.0-rc.4",
    "hono": "^4.13.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.2.6",
    "@cloudflare/workers-types": "^5.20260924.1",
    "@types/node": "^26.6.2",
    "dotenv": "^18.0.3",
    "drizzle-kit": "1.0.0-rc.4",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.110.0"
  }
}
