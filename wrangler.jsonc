{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rebirth-dungeon-server",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rebirth-dungeon",
      "database_id": "b8b044ef-47f2-4dec-9a13-11ce5c2ee31e",
      "remote": false,
    },
  ],
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "d0807df722f14a52bff8389d97890467",
    },
  ],
  "triggers": {
    "crons": ["* * * * *"],
  },
  "queues": {
    "producers": [{ "binding": "APP_QUEUE", "queue": "rebirth-dungeon-jobs" }],
    "consumers": [
      {
        "queue": "rebirth-dungeon-jobs",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "retry_delay": 30,
        "dead_letter_queue": "rebirth-dungeon-jobs-dlq",
      },
    ],
  },
  "send_email": [
    {
      "name": "EMAIL",
      "remote": false,
      "allowed_sender_addresses": ["noreply@rebirthdungeon.com"],
    },
  ],
  "vars": {
    "EMAIL_FROM": "noreply@rebirthdungeon.com",
    "EMAIL_FROM_NAME": "Rebirth Dungeon",
  },
  "secrets": { "required": ["JWT_ACCESS_SECRET"] },
  "ratelimits": [
    {
      "name": "CACHE_RATE_LIMIT",
      "namespace_id": "2026092501",
      "simple": { "limit": 30, "period": 60 },
    },
    {
      "name": "QUEUE_RATE_LIMIT",
      "namespace_id": "2026092401",
      "simple": { "limit": 10, "period": 60 },
    },
    {
      "name": "AUTH_RATE_LIMIT",
      "namespace_id": "2026092301",
      "simple": { "limit": 10, "period": 60 },
    },
    {
      "name": "REFRESH_RATE_LIMIT",
      "namespace_id": "2026092302",
      "simple": { "limit": 30, "period": 60 },
    },
  ],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 },
  },
}
