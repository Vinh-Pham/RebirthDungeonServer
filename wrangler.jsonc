{
  "name": "rebirth-dungeon-d1",
  "main": "worker/d1-proxy.ts",
  "compatibility_date": "2026-09-23",
  "kv_namespaces": [
    { "binding": "CACHE", "id": "REPLACE_WITH_KV_NAMESPACE_ID" },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rebirth-dungeon",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
    },
  ],
  "secrets": { "required": ["D1_PROXY_TOKEN"] },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 },
  },
}
