{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "lib": ["ES2022"],
    "types": ["node", "@cloudflare/vitest-plugin/types"],
    "esModuleInterop": true,
    "jsx": "react-jsx"
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts",
    "worker-configuration.d.ts",
    "vitest.config.ts",
    "drizzle.config.ts",
    "src/**/*.tsx",
    "test/**/*.tsx",
    "tools/**/*.ts"
  ]
}
